{
  "name": "mitra_engine",
  "version": "0.1.2",
  "type": "module",
  "description": "A 2D game engine for the web",
  "main": "./dist/engine.js",
  "types": "./dist/engine/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine.js"
    },
    "./tiled_plugin": {
      "types": "./dist/tiled_plugin/index.d.ts",
      "import": "./dist/tiled_plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build --config vite.lib.config.ts",
    "lint": "eslint . --ext .ts,.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0"
  },
  "dependencies": {
    "pako": "^3.0.2",
    "zod": "^4.6.7",
    "zstddec": "^0.3.1"
  }
}
