{
  "name": "mitra_engine",
  "version": "0.1.2",
  "type": "module",
  "description": "A 2D game engine for the web",
  "main": "./dist/engine.js",
  "types": "./dist/engine/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine.js"
    },
    "./tiled_plugin": {
      "types": "./dist/tiled_plugin/index.d.ts",
      "import": "./dist/tiled_plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build --config vite.lib.config.ts",
    "example1_flappy_bird": "vite --open /examples/example1_flappy_bird/",
    "example2_platformer": "vite --open /examples/example2_platformer/",
    "example3_space_shooter": "vite --open /examples/example3_space_shooter/",
    "example4_breakout": "vite --open /examples/example4_breakout/",
    "example5_islander": "vite --open /examples/example5_islander/",
    "example7_menu": "vite --open /examples/example7_menu/",
    "example8_matter_js": "vite --open /examples/example8_matter_js/",
    "lint": "eslint . --ext .ts,.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "@types/matter-js": "^0.20.2"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "pako": "^3.0.2",
    "zod": "^4.6.7",
    "zstddec": "^0.3.1"
  }
}
